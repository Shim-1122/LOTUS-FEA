@@ -28,6 +28,9 @@ SOFTWARE.*/
 #include "FECoreKernel.h"
 #include "FEModel.h"
 #include "FESurface.h"
+#include "FEModel.h"
+#include "FEMesh.h"
+#include "DumpStream.h"
 
 //-----------------------------------------------------------------------------
 FELogFaceData::FELogFaceData(FEModel* fem) : FELogData(fem) {}
@@ -98,3 +101,23 @@ void FaceDataRecord::SetItemList(FEItemList* itemList, const std::vector<int>& s
 		m_item = selection;
 	}
 }
+
+//-----------------------------------------------------------------------------
+// rlfea patch: DataRecord::Serialize does not store the surface, so after a
+// restart (-r) m_surface was null and the first logfile write crashed.
+void FaceDataRecord::Serialize(DumpStream& ar)
+{
+	DataRecord::Serialize(ar);
+	if (ar.IsShallow()) return;
+	std::string name;
+	if (ar.IsSaving())
+	{
+		if (m_surface) name = m_surface->GetName();
+		ar << name;
+	}
+	else
+	{
+		ar >> name;
+		m_surface = (name.empty() ? nullptr : GetFEModel()->GetMesh().FindSurface(name));
+	}
+}
