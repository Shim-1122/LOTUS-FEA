# run outputs stay out of version control; data/limb/*.stl is published by the owner's decision
*.STEP
*.aux
*.dmp
*.egg-info/
*.log
*.out
*.step
*.stl
*.stp
*.toc
*.xplt
.pytest_cache/
__pycache__/
data/private/
private/
runs/
verification_runs/

# socket CAD: data/socket/ is no longer ignored (owner request, 2026-11-01); the tessellation cache still is
.tess_*.pkl
!data/socket/
!data/socket/*.step
!data/socket/*.STEP
!examples/synthetic/*.stl
!data/limb/*.stl
